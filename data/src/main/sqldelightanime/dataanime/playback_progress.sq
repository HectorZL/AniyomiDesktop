CREATE TABLE playback_progress(
    _id INTEGER NOT NULL PRIMARY KEY,
    episode_id INTEGER NOT NULL,
    device_id TEXT NOT NULL,
    position_ms INTEGER NOT NULL,
    duration_ms INTEGER NOT NULL,
    last_update_time INTEGER NOT NULL,
    FOREIGN KEY(episode_id) REFERENCES episodes (_id)
    ON DELETE CASCADE
);

CREATE UNIQUE INDEX playback_progress_episode_device_index ON playback_progress(episode_id, device_id);
CREATE INDEX playback_progress_last_update_index ON playback_progress(last_update_time);

getForEpisodeAndDevice:
SELECT *
FROM playback_progress
WHERE episode_id = :episodeId
AND device_id = :deviceId;

upsert:
INSERT INTO playback_progress(episode_id, device_id, position_ms, duration_ms, last_update_time)
VALUES (:episodeId, :deviceId, :positionMs, :durationMs, :lastUpdateTime)
ON CONFLICT(episode_id, device_id)
DO UPDATE
SET
    position_ms = :positionMs,
    duration_ms = :durationMs,
    last_update_time = :lastUpdateTime
WHERE episode_id = :episodeId
AND device_id = :deviceId;

deleteForEpisodeAndDevice:
DELETE FROM playback_progress
WHERE episode_id = :episodeId
AND device_id = :deviceId;
